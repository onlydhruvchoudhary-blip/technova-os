# TECHNOVA OS environment configuration. Copy to `.env` and fill in real secrets.
# Generate strong secrets with:  openssl rand -hex 32

# --- required in production ---
SECRET_KEY=change-me-to-a-64-char-random-hex-string
QR_SECRET=change-me-to-another-random-hex-string
DB_PASSWORD=change-me-strong-db-password

# --- backend (read via TECHNOVA_ prefix) ---
TECHNOVA_ENVIRONMENT=production
# dev default is sqlite; prod uses Postgres (set by docker-compose)
# TECHNOVA_DATABASE_URL=postgresql+psycopg2://technova:password@db:5432/technova
TECHNOVA_ACCESS_TOKEN_EXPIRE_MINUTES=720

# daily anti-farming caps (points/day per category)
TECHNOVA_DAILY_CAP_LEARNING=200
TECHNOVA_DAILY_CAP_ATTENDANCE=60
TECHNOVA_DAILY_CAP_SOCIAL=150
TECHNOVA_QR_WINDOW_SECONDS=90
